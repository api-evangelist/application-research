{
  "opencollection": "1.0.0",
  "info": {
    "name": "Application Research CNAB Bundle API Resources Claim Results API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Claim Results",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Application Research List results for a claim",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.example.com/v1/claims/:id/results",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Claim ID (ULID)"
              }
            ]
          },
          "docs": "Application Research List results for a claim"
        },
        {
          "info": {
            "name": "Application Research Get a claim result by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.example.com/v1/results/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Result ID (ULID)"
              }
            ]
          },
          "docs": "Application Research Get a claim result by ID"
        }
      ]
    }
  ],
  "bundled": true
}