{
  "opencollection": "1.0.0",
  "info": {
    "name": "Application Research CNAB Bundle API Resources Extenders API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Extenders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Application Research Get extender",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.example.com/v1/planes/radius/:planeName/resourceGroups/:resourceGroupName/providers/Applications.Core/extenders/:extenderName",
            "params": [
              {
                "name": "planeName",
                "value": "",
                "type": "path",
                "description": "The name of the plane"
              },
              {
                "name": "resourceGroupName",
                "value": "",
                "type": "path",
                "description": "The name of the resource group"
              },
              {
                "name": "extenderName",
                "value": "",
                "type": "path",
                "description": "The name of the extender"
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "The API version to use for this operation"
              }
            ]
          },
          "docs": "Application Research Get extender"
        }
      ]
    }
  ],
  "bundled": true
}