{
  "opencollection": "1.0.0",
  "info": {
    "name": "Application Research CNAB Bundle API Resources Sources API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Application Research List sources for a component",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.example.com/v1/components/:name/sources",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Component name (e.g., github.com/acme.org/web-application)"
              },
              {
                "name": "version",
                "value": "",
                "type": "query",
                "description": "Component version (semver)"
              }
            ]
          },
          "docs": "Application Research List sources for a component"
        },
        {
          "info": {
            "name": "Application Research Add a source to a component",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.example.com/v1/components/:name/sources",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Component name (e.g., github.com/acme.org/web-application)"
              },
              {
                "name": "version",
                "value": "",
                "type": "query",
                "description": "Component version (semver)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Application Research Add a source to a component"
        }
      ]
    }
  ],
  "bundled": true
}