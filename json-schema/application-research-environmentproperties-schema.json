{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/EnvironmentProperties",
  "title": "EnvironmentProperties",
  "type": "object",
  "properties": {
    "provisioningState": {
      "$ref": "#/components/schemas/ProvisioningState",
