    "type"
  ],
  "properties": {
    "type": {
      "type": "string"
    },
    "customType": {
      "$ref": "#/components/schemas/SpecificationId"
    },
    "customDescription": {
      "type": "string",
      "minLength": 1
    },
    "callbackUrl": {
      "type": "string",
      "format": "uri"
    }
  }
}