{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/CredentialExchangeStrategy",
  "title": "Credential Exchange Strategy",
  "type": "object",
  "description": "Specifies how credentials can be obtained",
