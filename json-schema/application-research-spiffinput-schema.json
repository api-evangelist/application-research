{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/SpiffInput",
  "title": "SpiffInput",
  "type": "object",
  "description": "Spiff template input",
  "required": [
    "type",
    "path"
  ],
  "properties": {
    "type": {
      "const": "spiff"
    },
    "path": {
      "type": "string"
    },
    "mediaType": {
      "type": "string"
    },
    "compress": {
      "type": "boolean"
    },
    "values": {
      "type": "object"
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}