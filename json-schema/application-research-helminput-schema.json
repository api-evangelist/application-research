{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/HelmInput",
  "title": "HelmInput",
  "type": "object",
  "description": "Helm chart input",
  "required": [
    "type",
    "path"
  ],
  "properties": {
    "type": {
      "const": "helm"
    },
    "path": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "helmRepository": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "caCertFile": {
      "type": "string"
    },
    "caCert": {
      "type": "string"
    }
  }
}