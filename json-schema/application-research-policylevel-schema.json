{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PolicyLevel",
  "title": "PolicyLevel",
  "type": "string",
  "description": "Policy level for compliance",
  "oneOf": [
    {
      "type": "string",
      "pattern": "^([a-z0-9-]+(?:[.][a-z0-9-]+)*):([a-zA-Z0-9._\\-]+):(v0|v[1-9][0-9]*)$"
    },
    {
      "type": "string",
      "enum": [
        "none",
        "custom"
      ]
    }
  ]
}