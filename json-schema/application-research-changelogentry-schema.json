{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ChangelogEntry",
  "title": "Changelog Entry",
  "type": "object",
  "required": [
    "version",
    "releaseStatus",
    "date"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "releaseStatus": {
      "$ref": "#/components/schemas/ReleaseStatus"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    }
  }
}