{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/RelatedEntityType",
  "title": "Related Entity Type",
  "type": "object",
  "required": [
    "ordId"
  ],
  "properties": {
    "ordId": {
      "type": "string",
      "pattern": "^([a-z0-9]+(?:[.][a-z0-9]+)*):(entityType):([a-zA-Z0-9._\\-]+):(v0|v[1-9][0-9]*)$",
      "maxLength": 255
    },
    "relationType": {
      "type": "string",
      "enum": [
        "part-of",
        "can-share-identity"
      ]
    }
  }
}