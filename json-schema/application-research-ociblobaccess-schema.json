{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/OciBlobAccess",
  "title": "OciBlobAccess",
  "type": "object",
  "description": "Access to a specific OCI blob",
  "required": [
    "type",
    "imageReference",
    "mediaType",
    "digest",
    "size"
  ],
  "properties": {
    "type": {
      "const": "ociBlob"
    },
    "imageReference": {
      "type": "string"
    },
    "mediaType": {
      "type": "string"
    },
    "digest": {
      "type": "string"
    },
    "size": {
      "type": "integer"
    },
    "ref": {
      "type": "string"
    }
  }
}