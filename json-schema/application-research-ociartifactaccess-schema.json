  "$id": "#/components/schemas/OciArtifactAccess",
  "title": "OciArtifactAccess",
  "type": "object",
  "description": "Access to an OCI artifact",
  "required": [
    "type",
    "imageReference"
  ],
  "properties": {
    "type": {
      "const": "ociArtifact"
    },
    "imageReference": {
      "type": "string",
      "description": "OCI image reference"
    }
  }
}